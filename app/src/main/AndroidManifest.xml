<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Oprávnění pro celý stack; služby a aktivity si deklarují jejich úkoly. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 211: zjištění, zda je nainstalovaný Health Connect -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".app.NarsilApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Narsil">

        <!-- singleTask (132): návrat z OAuth Stravy přijde do běžící instance (onNewIntent), ne jako
             druhá MainActivity v úloze prohlížeče, ze které by „Zpět“ vyhodilo uživatele z Narsilu. -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 511: návrat z OAuth Stravy (Authorization Callback Domain = strava) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="narsil" android:host="strava" />
            </intent-filter>
        </activity>

        <!-- 211: Health Connect vyžaduje obrazovku s vysvětlením oprávnění (Android 13- a 14+) -->
        <activity-alias
            android:name=".app.HealthPermissionsRationale"
            android:exported="true"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".app.HealthPermissionsUsage"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- 110: detekce (AccessibilityService) -->
        <service
            android:name=".detection.accessibility.NarsilAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 113: ladění Ozvěny – adb shell am broadcast -a cz.narsil.DEBUG_ECHO -p cz.narsil -->
        <receiver
            android:name=".overlay.OverlayDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cz.narsil.DEBUG_ECHO" />
            </intent-filter>
        </receiver>

        <!-- 112: ladění kontextu, příkazy v ContextDebugReceiver -->
        <receiver
            android:name=".app.ContextDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cz.narsil.DEBUG_CONTEXT" />
            </intent-filter>
        </receiver>

        <!-- 124: fotka důkazu ze systémového fotoaparátu (ověření úkolů) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/narsil_file_paths" />
        </provider>
    </application>
</manifest>
